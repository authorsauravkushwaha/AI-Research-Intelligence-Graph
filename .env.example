# NEXUS configuration — copy to `.env` and fill in. NEVER commit `.env`.
# Everything here is optional except NEO4J_PASSWORD when you run docker compose.

# ---------------------------------------------------------------- Neo4j ---
# Leave NEO4J_URI empty to run the in-process engine (no database needed).
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEXUS_ENABLE_NEO4J=true
NEXUS_USE_GDS=true

# ------------------------------------------------------------------ LLM ---
# Any OpenAI-compatible endpoint. Empty key => the agent answers from graph
# evidence with deterministic templates (no LLM, no external calls).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200

# --------------------------------------------------- embeddings (optional) ---
# Point at any OpenAI-compatible embeddings endpoint for real vectors.
# Empty => the deterministic local hashing/lexical baseline is used.
NEXUS_EMBEDDINGS_URL=
NEXUS_EMBEDDINGS_KEY=
NEXUS_EMBEDDING_MODEL=text-embedding-3-small
NEXUS_EMBEDDING_DIM=384

# --------------------------------------------------------------- server ---
NEXUS_HOST=0.0.0.0
NEXUS_PORT=8000
NEXUS_CORS_ORIGINS=
NEXUS_MAX_GRAPH_NODES=400
NEXUS_MAX_GRAPH_EDGES=1200
NEXUS_RATE_LIMIT_PER_MINUTE=240
NEXUS_DEMO_MODE=true

# ------------------------------------------------- polyglot sidecars (opt) ---
NEXUS_INGEST_URL=http://127.0.0.1:8090
NEXUS_EXPORT_URL=http://127.0.0.1:8091
NEXUS_PLANNER_URL=http://127.0.0.1:8092
NEXUS_CLAIM_URL=
